# Copy this file to .env and fill in your own values.

# MongoDB connection string. It can point at MongoDB Atlas or a local server.
# Add a database name at the end (e.g. /facebook_clone).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/facebook_clone

# Optional: database name used when the URI above has no path.
# Defaults to "facebook_clone" if not set.
# MONGO_DB_NAME=facebook_clone